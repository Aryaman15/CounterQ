{
  "components": {
    "schemas": {
      "CreateRealtimeSessionRequest": {
        "properties": {
          "purpose": {
            "const": "interview_demo",
            "default": "interview_demo",
            "title": "Purpose",
            "type": "string"
          }
        },
        "title": "CreateRealtimeSessionRequest",
        "type": "object"
      },
      "CreateRealtimeSessionResponse": {
        "properties": {
          "client_secret": {
            "description": "Short-lived browser credential for OpenAI WebRTC.",
            "title": "Client Secret",
            "type": "string"
          },
          "expires_after_seconds": {
            "title": "Expires After Seconds",
            "type": "integer"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "const": "openai",
            "title": "Provider",
            "type": "string"
          },
          "transcription_model": {
            "title": "Transcription Model",
            "type": "string"
          },
          "turn_detection": {
            "$ref": "#/components/schemas/RealtimeTurnDetectionConfig"
          },
          "voice": {
            "title": "Voice",
            "type": "string"
          },
          "webrtc_url": {
            "title": "Webrtc Url",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "client_secret",
          "webrtc_url",
          "model",
          "voice",
          "transcription_model",
          "expires_at",
          "expires_after_seconds",
          "turn_detection"
        ],
        "title": "CreateRealtimeSessionResponse",
        "type": "object"
      },
      "DevelopmentReasoningSmokeRequest": {
        "properties": {
          "interview_session_id": {
            "format": "uuid",
            "title": "Interview Session Id",
            "type": "string"
          }
        },
        "required": [
          "interview_session_id"
        ],
        "title": "DevelopmentReasoningSmokeRequest",
        "type": "object"
      },
      "DevelopmentReasoningSmokeResponse": {
        "properties": {
          "cached_input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cached Input Tokens"
          },
          "capability": {
            "const": "STANDARD_REASONING",
            "title": "Capability",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "estimated_cost": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Cost"
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "invocation_id": {
            "format": "uuid",
            "title": "Invocation Id",
            "type": "string"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "reasoning_budget_remaining": {
            "title": "Reasoning Budget Remaining",
            "type": "integer"
          },
          "reasoning_budget_used": {
            "title": "Reasoning Budget Used",
            "type": "integer"
          },
          "status": {
            "const": "SUCCEEDED",
            "title": "Status",
            "type": "string"
          },
          "technical_note": {
            "title": "Technical Note",
            "type": "string"
          },
          "verdict": {
            "enum": [
              "GUARANTEED",
              "NOT_GUARANTEED",
              "UNCERTAIN"
            ],
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "invocation_id",
          "status",
          "provider",
          "model",
          "capability",
          "verdict",
          "technical_note",
          "confidence",
          "latency_ms",
          "input_tokens",
          "cached_input_tokens",
          "output_tokens",
          "estimated_cost",
          "currency",
          "reasoning_budget_used",
          "reasoning_budget_remaining"
        ],
        "title": "DevelopmentReasoningSmokeResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "environment"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "RealtimeDevelopmentBootstrapRequest": {
        "properties": {
          "purpose": {
            "const": "interview_demo",
            "default": "interview_demo",
            "title": "Purpose",
            "type": "string"
          }
        },
        "title": "RealtimeDevelopmentBootstrapRequest",
        "type": "object"
      },
      "RealtimeDevelopmentBootstrapResponse": {
        "properties": {
          "control_websocket_path": {
            "title": "Control Websocket Path",
            "type": "string"
          },
          "current_stage": {
            "title": "Current Stage",
            "type": "string"
          },
          "deadline_at": {
            "format": "date-time",
            "title": "Deadline At",
            "type": "string"
          },
          "interview_session_id": {
            "format": "uuid",
            "title": "Interview Session Id",
            "type": "string"
          },
          "protocol_version": {
            "const": "counterq.realtime.control.v1",
            "default": "counterq.realtime.control.v1",
            "title": "Protocol Version",
            "type": "string"
          },
          "state_version": {
            "title": "State Version",
            "type": "integer"
          }
        },
        "required": [
          "interview_session_id",
          "current_stage",
          "state_version",
          "deadline_at",
          "control_websocket_path"
        ],
        "title": "RealtimeDevelopmentBootstrapResponse",
        "type": "object"
      },
      "RealtimeTurnDetectionConfig": {
        "properties": {
          "create_response": {
            "const": false,
            "title": "Create Response",
            "type": "boolean"
          },
          "eagerness": {
            "const": "low",
            "title": "Eagerness",
            "type": "string"
          },
          "interrupt_response": {
            "const": true,
            "title": "Interrupt Response",
            "type": "boolean"
          },
          "type": {
            "const": "semantic_vad",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "eagerness",
          "create_response",
          "interrupt_response"
        ],
        "title": "RealtimeTurnDetectionConfig",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Stage 1 Core Interaction Spike API for CounterQ.",
    "title": "CounterQ API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
