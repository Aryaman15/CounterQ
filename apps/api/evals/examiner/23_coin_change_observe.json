            "approach_id": "bottom_up_amount_dp",
            "language": "java",
            "source_code": "class Solution { public int coinChange(int[] coins,int amount){int[] dp=new int[amount+1];java.util.Arrays.fill(dp,amount+1);dp[0]=0;for(int x=1;x<=amount;x++)for(int coin:coins)if(coin<=x)dp[x]=Math.min(dp[x],dp[x-coin]+1);return dp[amount]>amount?-1:dp[amount];} }",
            "review_status": "REVIEWED"
          }
