      "reference_solutions": [
        {
          "approach_id": "sort_and_linear_merge",
          "language": "cpp",
          "source_code": "class Solution { public: vector<vector<int>> merge(vector<vector<int>> intervals){ sort(intervals.begin(),intervals.end()); vector<vector<int>> out; for(auto interval:intervals){if(out.empty()||out.back()[1]<interval[0]) out.push_back(interval); else out.back()[1]=max(out.back()[1],interval[1]);} return out;} };",
          "review_status": "REVIEWED",
          "implementation_notes": "The vector parameter is passed by value, so the reference owns an O(n) input copy in addition to returned output; std::sort also uses implementation-dependent working stack space."
        },
        {
          "approach_id": "sort_and_linear_merge",
          "language": "python",
          "source_code": "class Solution:\n    def merge(self, intervals):\n        intervals.sort()\n        merged = []\n        for start, end in intervals:\n            if not merged or merged[-1][1] < start:\n                merged.append([start, end])\n            else:\n                merged[-1][1] = max(merged[-1][1], end)\n        return merged",
          "review_status": "REVIEWED",
          "implementation_notes": "The reference sorts the caller-provided list in place, returns O(n) output in the worst case, and Python's Timsort may use O(n) auxiliary storage."
        },
        {
          "approach_id": "sort_and_linear_merge",
          "language": "java",
          "source_code": "class Solution { public int[][] merge(int[][] intervals){ java.util.Arrays.sort(intervals,(a,b)->Integer.compare(a[0],b[0])); java.util.List<int[]> out=new java.util.ArrayList<>(); for(int[] interval:intervals){if(out.isEmpty()||out.get(out.size()-1)[1]<interval[0])out.add(interval);else out.get(out.size()-1)[1]=Math.max(out.get(out.size()-1)[1],interval[1]);}return out.toArray(new int[out.size()][]);} }",
          "review_status": "REVIEWED",
          "implementation_notes": "The reference sorts the caller-provided object array in place, returns O(n) output in the worst case, and object-array sorting may use O(n) auxiliary storage."
        }
