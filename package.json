{
  "name": "counterq",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "bootstrap": "pnpm install && uv sync --directory apps/api",
    "dev:web": "pnpm --filter @counterq/web dev",
    "dev:api": "uv run --directory apps/api uvicorn app.main:create_app --factory --reload --host 127.0.0.1 --port 8000",
    "dev:worker": "uv run --directory apps/api python -m app.worker.main",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:frontend": "pnpm --filter @counterq/web test",
    "test:backend": "uv run --directory apps/api pytest",
    "eval:stage1": "uv run --directory apps/api pytest tests/evaluation/stage1 -q",
    "eval:stage2a": "uv run --directory apps/api pytest tests/evaluation/stage2a -q",
    "eval:stage2b": "uv run --directory apps/api pytest tests/evaluation/stage2b -q",
    "lint": "pnpm run lint:frontend && pnpm run lint:backend",
    "lint:frontend": "pnpm --filter @counterq/web lint",
    "lint:backend": "uv run --directory apps/api ruff check .",
    "typecheck": "pnpm run typecheck:frontend && pnpm run typecheck:backend",
    "typecheck:frontend": "pnpm --filter @counterq/web typecheck",
    "typecheck:backend": "uv run --directory apps/api mypy app tests",
    "contracts": "pnpm run contracts:openapi && pnpm run contracts:generate",
    "contracts:openapi": "uv run --directory apps/api python -m app.contracts.openapi ../../packages/contracts/schemas/openapi.json",
    "contracts:generate": "pnpm --filter @counterq/contracts generate",
    "migrate": "uv run --directory apps/api alembic upgrade head",
    "migrate:create": "uv run --directory apps/api alembic revision --autogenerate -m"
  }
}
