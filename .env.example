COUNTERQ_APP_ENV=local
COUNTERQ_LOG_LEVEL=INFO
COUNTERQ_LOCAL_WEB_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql+asyncpg://counterq:counterq@localhost:5432/counterq
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
COUNTERQ_REALTIME_PROVIDER=openai
COUNTERQ_REALTIME_MODEL=gpt-realtime-2.1
COUNTERQ_REALTIME_VOICE=marin
COUNTERQ_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
COUNTERQ_REALTIME_REASONING_EFFORT=low
COUNTERQ_REALTIME_CLIENT_SECRET_TTL_SECONDS=600
COUNTERQ_REASONING_PROVIDER=openai
COUNTERQ_REASONING_STANDARD_MODEL=gpt-5.6-terra
COUNTERQ_REASONING_STRONG_MODEL=gpt-5.6-sol
COUNTERQ_REASONING_STANDARD_EFFORT=medium
COUNTERQ_REASONING_STRONG_EFFORT=high
COUNTERQ_REASONING_TIMEOUT_SECONDS=20
COUNTERQ_LIVE_EXAMINER_AUTOSTART=false
COUNTERQ_LIVE_EXAMINER_USEFULNESS_SECONDS=8
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
